{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tic-site",
  "compatibility_date": "2026-09-10",
  // Static site: Workers serves ./dist as assets, no Worker script needed.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "tic.kasvith.me", "custom_domain": true }]
}
